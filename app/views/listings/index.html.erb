<div class="flex flex-col lg:flex-row gap-6 lg:gap-8">
  <!-- Categories - horizontal on mobile, sidebar on desktop -->
  <aside class="lg:w-48 lg:shrink-0">
    <h3 class="font-semibold mb-3 hidden lg:block">Categories</h3>
    <div class="flex flex-wrap gap-2 lg:flex-col lg:gap-0 lg:space-y-1">
      <%= link_to "All", root_path, class: "px-3 py-1.5 lg:py-2 rounded text-sm lg:text-base #{@category.nil? ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 lg:bg-transparent hover:bg-gray-100'}" %>
      <% @categories.each do |category| %>
        <%= link_to category.name, category_path(category.slug), class: "px-3 py-1.5 lg:py-2 rounded text-sm lg:text-base #{@category == category ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 lg:bg-transparent hover:bg-gray-100'}" %>
      <% end %>
    </div>
  </aside>

  <!-- Listings Grid -->
  <div class="flex-1">
    <% if @category %>
      <h1 class="text-xl sm:text-2xl font-bold mb-4 sm:mb-6"><%= @category.name %></h1>
    <% end %>

    <% if @listings.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-6">
        <% @listings.each do |listing| %>
          <%= link_to listing_path(listing), class: "block p-4 border rounded-lg hover:shadow-md transition" do %>
            <div class="flex items-start gap-3 sm:gap-4">
              <% if listing.logo.attached? %>
                <%= image_tag listing.logo, class: "w-10 h-10 sm:w-12 sm:h-12 rounded object-cover" %>
              <% else %>
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded bg-gray-200 flex items-center justify-center text-gray-400">
                  <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              <% end %>
              <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-gray-900 truncate"><%= listing.name %></h3>
                <p class="text-sm text-gray-500 line-clamp-2"><%= listing.description %></p>
                <span class="inline-block mt-2 text-xs px-2 py-1 bg-gray-100 rounded"><%= listing.category.name %></span>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500">No listings yet.</p>
    <% end %>
  </div>
</div>
