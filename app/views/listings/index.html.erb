<div class="flex gap-8">
  <!-- Sidebar -->
  <aside class="w-48 shrink-0">
    <h3 class="font-semibold mb-3">Categories</h3>
    <ul class="space-y-1">
      <li>
        <%= link_to "All", root_path, class: "block px-3 py-2 rounded #{@category.nil? ? 'bg-blue-100 text-blue-800' : 'hover:bg-gray-100'}" %>
      </li>
      <% @categories.each do |category| %>
        <li>
          <%= link_to category.name, category_path(category.slug), class: "block px-3 py-2 rounded #{@category == category ? 'bg-blue-100 text-blue-800' : 'hover:bg-gray-100'}" %>
        </li>
      <% end %>
    </ul>
  </aside>

  <!-- Listings Grid -->
  <div class="flex-1">
    <% if @category %>
      <h1 class="text-2xl font-bold mb-6"><%= @category.name %></h1>
    <% end %>

    <% if @listings.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @listings.each do |listing| %>
          <%= link_to listing_path(listing), class: "block p-4 border rounded-lg hover:shadow-md transition" do %>
            <div class="flex items-start gap-4">
              <% if listing.logo.attached? %>
                <%= image_tag listing.logo, class: "w-12 h-12 rounded object-cover" %>
              <% else %>
                <div class="w-12 h-12 rounded bg-gray-200 flex items-center justify-center text-gray-400">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              <% end %>
              <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-gray-900 truncate"><%= listing.name %></h3>
                <p class="text-sm text-gray-500 line-clamp-2"><%= listing.description %></p>
                <span class="inline-block mt-2 text-xs px-2 py-1 bg-gray-100 rounded"><%= listing.category.name %></span>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500">No listings yet.</p>
    <% end %>
  </div>
</div>
