<div class="flex flex-col lg:flex-row gap-6 lg:gap-8">
  <!-- Categories - horizontal on mobile, sidebar on desktop -->
  <aside class="lg:w-48 lg:shrink-0">
    <h3 class="font-semibold mb-3 hidden lg:block"><%= t("listings.index.categories") %></h3>
    <ul class="menu menu-horizontal lg:menu-vertical bg-base-200 rounded-box lg:bg-transparent lg:p-0">
      <li><%= link_to t("listings.index.all"), root_path, class: @category.nil? ? "menu-active" : "" %></li>
      <% @categories.each do |category| %>
        <li><%= link_to category.name, category_path(category.slug), class: @category == category ? "menu-active" : "" %></li>
      <% end %>
    </ul>
  </aside>

  <!-- Listings Grid -->
  <div class="flex-1">
    <% if @category %>
      <h1 class="text-2xl font-bold mb-6"><%= @category.name %></h1>
    <% end %>

    <% if @listings.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-6">
        <%= render partial: "listings/card", collection: @listings, as: :listing %>
      </div>
    <% else %>
      <p class="text-base-content/60"><%= t("listings.index.no_listings") %></p>
    <% end %>
  </div>
</div>
