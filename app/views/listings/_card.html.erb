<div class="relative p-4 border rounded-lg hover:shadow-md transition group">
  <%= link_to listing.url, target: "_blank", rel: "noopener", class: "absolute top-3 right-3 p-1.5 text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded z-10", title: "Visit site" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
    </svg>
  <% end %>
  <%= link_to listing_path(listing), class: "block" do %>
    <div class="flex items-start gap-3 sm:gap-4 pr-8">
      <% if listing.logo.attached? %>
        <%= image_tag listing.logo, class: "w-10 h-10 sm:w-12 sm:h-12 rounded object-cover" %>
      <% else %>
        <div class="w-10 h-10 sm:w-12 sm:h-12 rounded bg-gray-200 flex items-center justify-center text-gray-400">
          <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
      <% end %>
      <div class="flex-1 min-w-0">
        <h3 class="font-semibold text-gray-900 truncate"><%= listing.name %></h3>
        <p class="text-sm text-gray-500 line-clamp-2"><%= listing.description %></p>
        <span class="inline-block mt-2 text-xs px-2 py-1 bg-gray-100 rounded"><%= listing.category.name %></span>
      </div>
    </div>
  <% end %>
</div>
