<div class="card card-border bg-base-100 hover:shadow-md transition">
  <div class="card-body p-4">
    <div class="flex items-start gap-3 sm:gap-4">
      <%= link_to listing.url, target: "_blank", rel: "noopener", class: "btn btn-ghost btn-sm absolute top-3 right-3", title: t("listings.card.visit_site") do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      <% end %>
      <%= link_to listing_path(listing), class: "flex items-start gap-3 sm:gap-4 flex-1 pr-8" do %>
        <div class="avatar">
          <div class="w-10 sm:w-12 rounded">
            <% if listing.logo.attached? %>
              <%= image_tag listing.logo %>
            <% else %>
              <%= image_tag "https://www.google.com/s2/favicons?domain=#{URI.parse(listing.url).host}&sz=128", alt: listing.name %>
            <% end %>
          </div>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="card-title text-base"><%= listing.name %></h3>
          <p class="text-sm text-base-content/60 line-clamp-2"><%= listing.description %></p>
        </div>
      <% end %>
    </div>
    <% if listing.tags.any? %>
      <div class="flex flex-wrap gap-2 mt-2">
        <% listing.tags.first(3).each do |tag| %>
          <%= link_to "##{tag.name}", tag_path(tag.slug), class: "text-xs text-base-content/60 hover:text-primary" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
