<div class="max-w-2xl mx-auto">
  <%= link_to "← #{t('listings.show.back')}", root_path, class: "text-gray-500 hover:text-gray-700 mb-4 sm:mb-6 inline-block" %>

  <div class="bg-white border rounded-lg p-4 sm:p-6">
    <div class="flex items-start gap-4 sm:gap-6">
      <% if @listing.logo.attached? %>
        <%= image_tag @listing.logo, class: "w-16 h-16 sm:w-20 sm:h-20 rounded-lg object-cover" %>
      <% else %>
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-lg bg-gray-200 flex items-center justify-center text-gray-400">
          <svg class="w-8 h-8 sm:w-10 sm:h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
      <% end %>

      <div class="flex-1 min-w-0">
        <h1 class="text-xl sm:text-2xl font-bold"><%= @listing.name %></h1>
        <p class="text-gray-500 mt-1">
          <%= link_to @listing.category.name, category_path(@listing.category.slug), class: "hover:underline" %>
        </p>
      </div>
    </div>

    <div class="mt-6">
      <p class="text-gray-700 whitespace-pre-wrap"><%= @listing.description %></p>
    </div>

    <div class="mt-6">
      <%= link_to @listing.url, target: "_blank", rel: "noopener", class: "inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded" do %>
        <%= t("listings.show.visit_site") %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      <% end %>
    </div>

    <div class="mt-6 pt-6 border-t text-sm text-gray-500">
      <%= t("listings.show.submitted_by", name: @listing.user.name) %>
    </div>
  </div>

  <% if @similar_listings.any? %>
    <div class="mt-8">
      <h2 class="text-lg font-semibold mb-4"><%= t("listings.show.alternatives_to", name: @listing.name) %></h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <%= render partial: "listings/card", collection: @similar_listings, as: :listing %>
      </div>
    </div>
  <% end %>
</div>
