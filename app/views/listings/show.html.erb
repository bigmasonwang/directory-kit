<div class="max-w-2xl mx-auto">
  <%= link_to "← #{t('listings.show.back')}", root_path, class: "btn btn-ghost btn-sm mb-4" %>

  <div class="card card-border bg-base-100">
    <div class="card-body">
      <div class="flex items-start gap-4 sm:gap-6">
        <% if @listing.logo.attached? %>
          <div class="avatar">
            <div class="w-16 sm:w-20 rounded-lg">
              <%= image_tag @listing.logo %>
            </div>
          </div>
        <% else %>
          <div class="avatar placeholder">
            <div class="bg-base-300 text-base-content/40 w-16 sm:w-20 rounded-lg">
              <svg class="w-8 h-8 sm:w-10 sm:h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
          </div>
        <% end %>

        <div class="flex-1 min-w-0">
          <h1 class="card-title text-xl sm:text-2xl"><%= @listing.name %></h1>
          <p class="text-base-content/60 mt-1">
            <%= link_to @listing.category.name, category_path(@listing.category.slug), class: "link link-hover" %>
          </p>
          <% if @listing.tags.any? %>
            <div class="flex flex-wrap gap-1 mt-2">
              <% @listing.tags.each do |tag| %>
                <%= link_to tag.name, tag_path(tag.slug), class: "badge badge-outline badge-sm hover:badge-primary" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mt-6">
        <p class="whitespace-pre-wrap"><%= @listing.description %></p>
      </div>

      <div class="card-actions mt-6">
        <%= link_to @listing.url, target: "_blank", rel: "noopener", class: "btn btn-primary" do %>
          <%= t("listings.show.visit_site") %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        <% end %>
      </div>

      <div class="divider"></div>

      <p class="text-sm text-base-content/60">
        <%= t("listings.show.submitted_by", name: @listing.user.name) %>
      </p>
    </div>
  </div>

  <% if @similar_listings.any? %>
    <div class="mt-8">
      <h2 class="text-lg font-semibold mb-4"><%= t("listings.show.alternatives_to", name: @listing.name) %></h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <%= render partial: "listings/card", collection: @similar_listings, as: :listing %>
      </div>
    </div>
  <% end %>
</div>
