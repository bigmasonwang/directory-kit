<div class="max-w-xl mx-auto">
  <h1 class="text-2xl font-bold mb-6"><%= t("listings.new.title") %></h1>

  <%= form_with model: @listing, class: "space-y-6" do |f| %>
    <% if @listing.errors.any? %>
      <div role="alert" class="alert alert-error">
        <ul class="list-disc list-inside">
          <% @listing.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <fieldset class="fieldset">
      <legend class="fieldset-legend"><%= t("listings.new.name") %></legend>
      <%= f.text_field :name, class: "input w-full", required: true %>
    </fieldset>

    <fieldset class="fieldset">
      <legend class="fieldset-legend"><%= t("listings.new.url") %></legend>
      <%= f.url_field :url, class: "input w-full", placeholder: "https://", required: true %>
    </fieldset>

    <fieldset class="fieldset">
      <legend class="fieldset-legend"><%= t("listings.new.category") %></legend>
      <%= f.collection_select :category_id, @categories, :id, :name, { prompt: t("listings.new.category_prompt") }, { class: "select w-full", required: true } %>
    </fieldset>

    <fieldset class="fieldset">
      <legend class="fieldset-legend"><%= t("listings.new.tags") %></legend>
      <%= f.select :tag_ids,
          @tags.map { |t| [t.name, t.id] },
          {},
          {
            multiple: true,
            data: {
              controller: "tag-select",
              tag_select_options_value: @tags.map { |t| { id: t.id, name: t.name } }.to_json
            }
          } %>
      <p class="label"><%= t("listings.new.tags_hint") %></p>
    </fieldset>

    <fieldset class="fieldset">
      <legend class="fieldset-legend"><%= t("listings.new.description") %></legend>
      <%= f.text_area :description, class: "textarea w-full", rows: 4, required: true %>
    </fieldset>

    <fieldset class="fieldset">
      <legend class="fieldset-legend"><%= t("listings.new.logo") %></legend>
      <%= f.file_field :logo, accept: "image/*", class: "file-input w-full" %>
      <p class="label"><%= t("listings.new.logo_hint") %></p>
    </fieldset>

    <div>
      <%= f.submit t("listings.new.submit"), class: "btn btn-primary btn-block" %>
    </div>
  <% end %>
</div>
