<!DOCTYPE html>
<html data-theme="fantasy">
  <head>
    <title><%= content_for(:title) || "Dirkit" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Dirkit">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="navbar bg-base-100 border-b border-base-300">
      <div class="navbar-start">
        <%= link_to "Dirkit", root_path, class: "btn btn-ghost text-xl" %>
      </div>
      <div class="navbar-end gap-2">
        <%= select_tag :locale, options_for_select(locale_options_for_select, current_locale_url), class: "select select-sm select-ghost", onchange: "window.location.href = this.value" %>
        <% if signed_in? %>
          <%= link_to t("layouts.header.submit"), new_listing_path, class: "btn btn-primary btn-sm" %>
          <div class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar">
              <div class="w-10 rounded-full">
                <% if current_user.avatar_url.present? %>
                  <%= image_tag current_user.avatar_url, alt: current_user.name %>
                <% else %>
                  <div class="bg-base-300 w-full h-full flex items-center justify-center text-base-content/60">
                    <%= current_user.name.first.upcase %>
                  </div>
                <% end %>
              </div>
            </div>
            <ul tabindex="-1" class="menu menu-sm dropdown-content bg-base-100 rounded-box z-10 mt-3 w-52 p-2 shadow">
              <li class="menu-title"><%= current_user.name %></li>
              <% if current_user.admin? %>
                <li><%= link_to t("layouts.header.admin"), "/avo" %></li>
              <% end %>
              <li><%= button_to t("layouts.header.sign_out"), logout_path, method: :delete %></li>
            </ul>
          </div>
        <% else %>
          <%= button_to t("layouts.header.sign_in"), "/auth/google_oauth2", method: :post, data: { turbo: false }, class: "btn btn-primary btn-sm" %>
        <% end %>
      </div>
    </div>

    <main class="container mx-auto py-8 px-5">
      <% if notice %>
        <div role="alert" class="alert alert-success mb-4">
          <span><%= notice %></span>
        </div>
      <% end %>
      <% if alert %>
        <div role="alert" class="alert alert-error mb-4">
          <span><%= alert %></span>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
