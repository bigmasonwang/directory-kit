<!DOCTYPE html>
<html data-theme="fantasy">
  <head>
    <title><%= content_for(:title) || "Dirkit" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Dirkit">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="navbar bg-base-100 border-b border-base-300">
      <div class="navbar-start">
        <%= link_to "Dirkit", root_path, class: "btn btn-ghost text-xl" %>
      </div>
      <div class="navbar-end gap-2">
        <div class="dropdown dropdown-end">
          <div tabindex="0" role="button" class="btn btn-sm btn-ghost gap-1" aria-label="Language" title="Change Language">
            <svg class="size-4 text-base-content/70" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" d="M12 21a9 9 0 1 0 0-18m0 18a9 9 0 1 1 0-18m0 18c2.761 0 3.941-5.163 3.941-9S14.761 3 12 3m0 18c-2.761 0-3.941-5.163-3.941-9S9.239 3 12 3M3.5 9h17m-17 6h17"></path>
            </svg>
            <span class="text-xs font-bold"><%= current_locale_code %></span>
            <svg class="size-2 fill-current opacity-60" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 2048 2048">
              <path d="M1799 349l242 241-1017 1017L7 590l242-241 775 775 775-775z"></path>
            </svg>
          </div>
          <ul tabindex="-1" class="dropdown-content menu menu-sm bg-base-200 rounded-box z-10 mt-3 w-40 p-2 shadow">
            <% I18n.available_locales.each do |locale| %>
              <li>
                <%= link_to locale_url(locale), class: (I18n.locale == locale ? "menu-active" : "") do %>
                  <span class="font-mono text-xs font-bold opacity-40"><%= locale_code(locale) %></span>
                  <span><%= locale_name(locale) %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
        <% if signed_in? %>
          <%= link_to t("layouts.header.submit"), new_listing_path, class: "btn btn-primary btn-sm" %>
          <div class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar">
              <div class="w-10 rounded-full">
                <% if current_user.avatar_url.present? %>
                  <%= image_tag current_user.avatar_url, alt: current_user.name %>
                <% else %>
                  <div class="bg-base-300 w-full h-full flex items-center justify-center text-base-content/60">
                    <%= current_user.name.first.upcase %>
                  </div>
                <% end %>
              </div>
            </div>
            <ul tabindex="-1" class="menu menu-sm dropdown-content bg-base-100 rounded-box z-10 mt-3 w-52 p-2 shadow">
              <li class="menu-title"><%= current_user.name %></li>
              <% if current_user.admin? %>
                <li><%= link_to t("layouts.header.admin"), "/avo" %></li>
              <% end %>
              <li><%= button_to t("layouts.header.sign_out"), logout_path, method: :delete %></li>
            </ul>
          </div>
        <% else %>
          <%= button_to t("layouts.header.sign_in"), "/auth/google_oauth2", method: :post, data: { turbo: false }, class: "btn btn-primary btn-sm" %>
        <% end %>
      </div>
    </div>

    <main class="container mx-auto py-8 px-5">
      <% if notice %>
        <div role="alert" class="alert alert-success mb-4">
          <span><%= notice %></span>
        </div>
      <% end %>
      <% if alert %>
        <div role="alert" class="alert alert-error mb-4">
          <span><%= alert %></span>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
