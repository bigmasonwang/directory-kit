<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Dirkit" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Dirkit">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="border-b bg-white">
      <nav class="container mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-2">
        <%= link_to "Dirkit", root_path, class: "text-xl font-bold" %>

        <div class="flex items-center gap-2 sm:gap-4">
          <% if signed_in? %>
            <%= link_to "Submit", new_listing_path, class: "px-3 py-1.5 sm:px-4 sm:py-2 text-sm sm:text-base bg-blue-600 hover:bg-blue-700 text-white rounded" %>
            <% if current_user.admin? %>
              <%= link_to "Admin", "/avo", class: "text-gray-600 hover:text-gray-900 text-sm sm:text-base" %>
            <% end %>
            <div class="flex items-center gap-2">
              <% if current_user.avatar_url.present? %>
                <%= image_tag current_user.avatar_url, class: "w-7 h-7 sm:w-8 sm:h-8 rounded-full", alt: current_user.name %>
              <% end %>
              <%= button_to "Sign out", logout_path, method: :delete, class: "text-gray-600 hover:text-gray-900 text-sm sm:text-base" %>
            </div>
          <% else %>
            <%= button_to "Sign in", "/auth/google_oauth2", method: :post, data: { turbo: false }, class: "px-3 py-1.5 sm:px-4 sm:py-2 text-sm sm:text-base bg-blue-600 hover:bg-blue-700 text-white rounded" %>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="container mx-auto py-8 px-5">
      <% if notice %>
        <div class="mb-4 p-4 bg-green-100 text-green-800 rounded"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="mb-4 p-4 bg-red-100 text-red-800 rounded"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
