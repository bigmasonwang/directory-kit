<div class="min-h-screen flex items-center justify-center">
  <div class="text-center">
    <h1 class="text-4xl font-bold mb-8">Dirkit</h1>

    <% if signed_in? %>
      <div class="mb-6">
        <% if current_user.avatar_url.present? %>
          <%= image_tag current_user.avatar_url, class: "w-16 h-16 rounded-full mx-auto mb-4", alt: current_user.name %>
        <% end %>
        <p class="text-lg text-gray-700">Welcome, <%= current_user.name %></p>
        <p class="text-sm text-gray-500"><%= current_user.email %></p>
      </div>

      <%= button_to "Sign out", logout_path, method: :delete, class: "px-4 py-2 bg-gray-200 hover:bg-gray-300 rounded" %>

      <% if current_user.admin? %>
        <p class="mt-4">
          <%= link_to "Admin", "/avo", class: "text-blue-600 hover:underline" %>
        </p>
      <% end %>
    <% else %>
      <%= button_to "Sign in with Google", "/auth/google_oauth2", method: :post, data: { turbo: false }, class: "px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg" %>
    <% end %>
  </div>
</div>
