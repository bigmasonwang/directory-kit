<% content_for :title, "#{@post.title} - #{t('seo.site_name')}" %>
<% content_for :description, truncate(strip_tags(@post.body), length: 160) %>
<% content_for :og_type, "article" %>

<div class="max-w-2xl mx-auto">
  <%= link_to "← #{t('posts.show.back')}", posts_path, class: "btn btn-ghost btn-sm mb-4" %>

  <article class="card card-border bg-base-100">
    <div class="card-body">
      <h1 class="card-title text-2xl"><%= @post.title %></h1>
      <p class="text-sm text-base-content/60">
        <%= l(@post.published_at, format: :long) %>
      </p>

      <div class="divider"></div>

      <div class="prose max-w-none">
        <%= render_markdown(@post.body) %>
      </div>
    </div>
  </article>
</div>
