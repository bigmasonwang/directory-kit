<% content_for :title, "#{t('posts.index.title')} - #{t('seo.site_name')}" %>

<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold mb-6"><%= t("posts.index.title") %></h1>

  <% if @posts.any? %>
    <div class="space-y-6">
      <% @posts.each do |post| %>
        <article class="card card-border bg-base-100">
          <div class="card-body">
            <h2 class="card-title">
              <%= link_to post.title, post_path(slug: post.slug), class: "link link-hover" %>
            </h2>
            <p class="text-sm text-base-content/60">
              <%= l(post.published_at, format: :long) %>
            </p>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="text-base-content/60"><%= t("posts.index.no_posts") %></p>
  <% end %>
</div>
